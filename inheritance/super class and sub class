public class Person {
    int id;
    int age;
    char gender;

    void setData() {
        id = 100;
        age = 25;
        gender = 'M';
    }

    void display() {
        System.out.println("Id: " + id);
        System.out.println("Age: " + age);
        System.out.println("Gender: " + gender);
    }
}

class Emp extends Person {
    float salary;

    void display() {
        super.display();
        System.out.println("Salary: " + salary);
    }
}

public class PersonTest {
    public static void main(String[] args) {
        Emp e1 = new Emp();

        e1.setData();
        e1.display();
    }
}
