here keyword is not required because the signature is different

public class Sample {
	int a;
	int b;
public void setdata(int x, int y)
{
	a=x;
	b=y;
	}
public void dispAB()
{
	System.out.println(a+"\t"+b);
}
}
public class Test extends Sample
{
	int c;
	int d;
	public void setdata(int x,int y,int z,int f)
	{
		setdata(x,y);//super keyword is not required because its signatures is different
		c=z;
		d=f;
	}
	public void dispAB()
	{
		super.dispAB();
		System.out.println(c+"\t"+d);
	}
}

public class Inheritance {

	public static void main(String[] args) {
		Test t1 = new Test();
		t1.setdata(1,2,3,4);
		t1.dispAB();
	}
}
