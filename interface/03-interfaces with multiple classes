interface Payment {
    void pay();
}

class UPI implements Payment {
    public void pay() {
        System.out.println("Payment through UPI");
    }
}

class Card implements Payment {
    public void pay() {
        System.out.println("Payment through Card");
    }
}

public class Main {
    public static void main(String[] args) {

        UPI u = new UPI();
        Card c = new Card();

        u.pay();
        c.pay();
    }
}
