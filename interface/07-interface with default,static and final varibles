interface Vehicle {

    void start();

    default void alarm() {
        System.out.println("Alarm is ON");
    }

    static void service() {
        System.out.println("Vehicle service required");
    }
}

class Car implements Vehicle {

    public void start() {
        System.out.println("Car started");
    }
}

public class Main {
    public static void main(String[] args) {

        Car c = new Car();

        c.start();
        c.alarm();

        Vehicle.service();
    }
}
