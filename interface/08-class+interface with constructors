class Electronics {

    String brand;

    Electronics(String brand) {
        this.brand = brand;
    }

    void powerOn() {
        System.out.println(brand + " is powering on");
    }
}

interface Camera {
    void takePhoto();
}

class Smartphone extends Electronics implements Camera {

    Smartphone(String brand) {
        super(brand);
    }

    public void takePhoto() {
        System.out.println("Taking photo with " + brand);
    }
}

public class Main {
    public static void main(String[] args) {

        Smartphone phone = new Smartphone("Samsung");

        phone.powerOn();
        phone.takePhoto();
    }
}
